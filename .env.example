# server
PORT=4000
DB=mongodb://localhost:27017/texas-ai
ADMIN_API_KEY=change-me
# https origin Twilio can reach (ngrok in dev), no trailing slash
PUBLIC_BASE_URL=https://your-domain.example.com
TIMEZONE=America/Chicago

# intake mailbox (IMAP polling)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=abc@gmail.com
# for gmail use an App Password (Google account -> Security -> 2-Step -> App passwords)
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
EMAIL_POLL_INTERVAL_MS=60000

# openai
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
EXTRACTION_INTERVAL_MS=20000
# same patient + same study within this many days = re-sent slip, held for review
DUPLICATE_WINDOW_DAYS=30

# google sheets (share the sheet with the service account email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=TIN ALL
# either a path to the service-account key file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# ...or the raw/base64 json inline
# GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_INTAKE_TAG=AI 2026
SHEET_BILLER_DEFAULT=DIRECT
SHEET_FC_DEFAULT=LOP

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_VALIDATE_WEBHOOKS=false
CLINIC_CALLBACK_NUMBER=+1XXXXXXXXXX

# calling behaviour
CALL_SCHEDULER_INTERVAL_MS=60000
CALL_MAX_ATTEMPTS=3
CALL_RETRY_HOURS=4
CALL_RING_TIMEOUT_SEC=30
# hard cap on call length (Twilio timeLimit) + silence handling
CALL_MAX_DURATION_SEC=900
CALL_SILENCE_NUDGE_SEC=20
CALL_SILENCE_MAX_NUDGES=2
CALL_HOURS_START=9
CALL_HOURS_END=19
CALLS_PER_TICK=2
SMS_ON_MISSED_CALL=true

# booking window offered by the voice agent
BOOKING_HOURS_START=8
BOOKING_HOURS_END=18
BOOKING_DAYS_AHEAD=14
BOOKING_INCLUDE_SATURDAY=false
